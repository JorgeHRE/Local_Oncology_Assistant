# Copy to .env and set a real password. .env is gitignored; never commit it.
POSTGRES_USER=omop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=omop
POSTGRES_PORT=5432

# Optional: contact email sent to NCBI E-utilities (only used to warn before blocking an IP).
# Use a project address, not a personal one, if you set it.
NCBI_EMAIL=
